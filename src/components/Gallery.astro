---
/**
 * Photo gallery: a stack of horizontal bars, each showing a band of a photo.
 * Clicking a bar opens a full-screen viewer with previous/next navigation
 * (buttons, arrow keys, swipe; on narrow screens swipe only). Double-click or
 * double-tap the photo to see it at 100% and drag to pan; again to fit.
 *
 * Photos live in src/assets/photos/ so Astro can resize and convert them at
 * build time. Pass either the file name (e.g. "DSC00238.jpg") or an imported
 * image as `src`.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
	images: Array<{
		src: string | ImageMetadata;
		alt: string;
		/** Which part of the photo the bar shows, as CSS object-position (default "center"). */
		position?: string;
	}>;
}

const photos = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/photos/*.{jpg,jpeg,png,webp,avif}",
	{ eager: true }
);

function resolve(src: string | ImageMetadata): ImageMetadata {
	if (typeof src !== "string") return src;
	const name = src.split("/").pop();
	const match = photos[`/src/assets/photos/${name}`];
	if (!match) {
		throw new Error(`Gallery: "${src}" not found. Put the photo in src/assets/photos/.`);
	}
	return match.default;
}

const { images } = Astro.props;

const items = await Promise.all(
	images.map(async (image) => {
		const meta = resolve(image.src);
		const bar = await getImage({
			src: meta,
			widths: [480, 720, 960, 1280],
			format: "webp",
			quality: 75,
		});
		const large = await getImage({
			src: meta,
			widths: [1024, 1600, 2400]
				.filter((w) => w < meta.width)
				.concat(meta.width <= 2400 ? [meta.width] : []),
			format: "webp",
			quality: 82,
		});
		// Full size, only fetched when the viewer zooms to 100%.
		const full = await getImage({ src: meta, width: meta.width, format: "webp", quality: 82 });
		// Used in the URL hash (e.g. #DSC00238) so each photo can be linked to.
		const id = (typeof image.src === "string" ? image.src : meta.src)
			.split("/")
			.pop()!
			.split(".")[0]
			.split("?")[0];
		return {
			id,
			alt: image.alt,
			position: image.position ?? "center",
			width: meta.width,
			height: meta.height,
			bar,
			large,
			full,
		};
	})
);
---

<div class="not-prose gallery" data-gallery>
	<ul class="gallery-stack">
		{items.map((item, index) => (
			<li style={`z-index: ${index + 1}`}>
				<button
					type="button"
					class="gallery-bar"
					data-index={index}
					data-id={item.id}
					data-large-src={item.large.src}
					data-large-srcset={item.large.srcSet.attribute}
					data-full-src={item.full.src}
					data-width={item.width}
					data-height={item.height}
					aria-label={`Open photo ${index + 1} of ${items.length}: ${item.alt}`}
				>
					<img
						src={item.bar.src}
						srcset={item.bar.srcSet.attribute}
						sizes="(min-width: 768px) 640px, 100vw"
						width={item.width}
						height={item.height}
						alt={item.alt}
						style={`object-position: ${item.position}`}
						loading={index < 3 ? "eager" : "lazy"}
						decoding="async"
					/>
					<span class="gallery-caption">{item.alt}</span>
				</button>
			</li>
		))}
	</ul>

	<dialog class="gallery-viewer" aria-label="Photo viewer" tabindex="-1">
		<div class="gallery-stage">
			<img class="gallery-photo" alt="" draggable="false" />
		</div>
		<p class="gallery-meta">
			<span class="gallery-meta-caption"></span>
		</p>
		<button type="button" class="gallery-btn gallery-close" aria-label="Close">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
		<nav class="gallery-nav" aria-label="Photo navigation">
			<button type="button" class="gallery-btn gallery-prev" aria-label="Previous photo">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 15l7-7 7 7" />
				</svg>
			</button>
			<div class="gallery-dots" role="group" aria-label="Photos">
				{items.map((item, index) => (
					<button
						type="button"
						class="gallery-dot"
						data-index={index}
						aria-label={`Photo ${index + 1}: ${item.alt}`}
					/>
				))}
			</div>
			<button type="button" class="gallery-btn gallery-next" aria-label="Next photo">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 9l7 7 7-7" />
				</svg>
			</button>
		</nav>
	</dialog>
</div>

<style>
	/* ---------- Stack ---------- */
	.gallery {
		margin: 2.5rem 0 3rem;
		/* Height of each stripe, how far it tucks under the next one, and how
		   far it nudges up on hover (must stay below --tuck). */
		--stripe: 4.5rem;
		--tuck: 12px;
		--nudge: 8px;
	}
	@media (min-width: 640px) {
		.gallery {
			--stripe: 7rem;
		}
	}
	.gallery-stack {
		/* Keep the stripes' z-indexes inside the stack, below the fixed menu. */
		isolation: isolate;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* A straight stack of stripes, each cropped from its photo. Each stripe
	   lies on top of the one before it and casts the blog's solid translucent
	   shadow bar up onto it. */
	.gallery-stack > li {
		position: relative;
	}
	/* Each stripe extends a little under the next one, so nudging it up on
	   hover reveals more photo instead of a gap. */
	.gallery-stack > li + li {
		margin-top: calc(-1 * var(--tuck));
	}
	/* The shadow belongs to the stripe, so it moves with it on hover. */
	.gallery-stack > li + li .gallery-bar {
		box-shadow: 0 -16px 0 rgb(0 0 0 / 0.4);
	}
	.gallery-bar {
		position: relative;
		display: block;
		width: 100%;
		height: var(--stripe);
		padding: 0;
		border: 0;
		overflow: hidden;
		cursor: zoom-in;
		background: #d6d6cf;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.gallery-bar img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.gallery-caption {
		position: absolute;
		right: 0.75rem;
		top: 0.6rem;
		padding: 0.15rem 0.5rem;
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: #eaeae3;
		background: rgb(40 40 39 / 0.6);
		opacity: 0;
		transform: translateY(-3px);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
		pointer-events: none;
	}
	@media (hover: hover) {
		/* Pull the photo gently out of the pile. */
		.gallery-bar:hover {
			transform: translateY(calc(-1 * var(--nudge)));
		}
		.gallery-bar:hover .gallery-caption {
			opacity: 1;
			transform: none;
		}
	}
	.gallery-bar:focus-visible {
		outline: 3px solid #3b2ee6;
		outline-offset: 3px;
		transform: translateY(calc(-1 * var(--nudge)));
	}

	/* ---------- Viewer ---------- */
	.gallery-viewer:focus {
		outline: none;
	}
	.gallery-viewer {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #282827;
		overflow: hidden;
		overscroll-behavior: contain;
	}
	/* Blur the page and wash it out towards the site's off-white. */
	.gallery-viewer::backdrop {
		background: rgb(234 234 227 / 0.72);
		-webkit-backdrop-filter: blur(18px) saturate(0.85);
		backdrop-filter: blur(18px) saturate(0.85);
		transition:
			background 0.35s ease,
			backdrop-filter 0.35s ease,
			-webkit-backdrop-filter 0.35s ease;
	}
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.gallery-viewer::backdrop {
			background: rgb(234 234 227 / 0.94);
		}
	}
	.gallery-viewer.is-fading::backdrop {
		background: rgb(234 234 227 / 0);
		-webkit-backdrop-filter: blur(0) saturate(1);
		backdrop-filter: blur(0) saturate(1);
	}
	/* One gap everywhere:
	     across: [gap][photo][gap][nav column][gap]
	     down:   [gap][photo + shadow][gap][title][gap]
	   The nav column stays on the right edge. The photo and title are centred
	   in the room left of it: the script sets --shift and --vshift to half the
	   room the photo leaves free in each direction. */
	.gallery-viewer {
		--gap: 1rem;
		--nav: 2.1rem;
		--meta: 2rem;
		--shadow: 16px;
		--shift: 0px;
		--vshift: 0px;
		--right: calc(var(--gap) * 2 + var(--nav) + var(--shift));
		--bottom: calc(var(--gap) * 2 + var(--meta) + var(--vshift));
	}
	.gallery-stage {
		position: absolute;
		inset: calc(var(--gap) + var(--vshift)) var(--right) calc(var(--bottom) + var(--shadow))
			var(--gap);
		display: flex;
		align-items: flex-end;
		/* Sit the photo against the nav column and the title. */
		justify-content: flex-end;
		touch-action: pan-y pinch-zoom;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
	}
	.gallery-photo {
		/* Zooming scales from the top-left corner (see the script). */
		transform-origin: 0 0;
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		box-shadow: 0 var(--shadow) 0 rgb(0 0 0 / 0.4);
		will-change: transform;
	}
	.gallery-meta-caption {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.gallery-meta {
		position: absolute;
		left: var(--gap);
		right: var(--right);
		bottom: calc(var(--gap) + var(--vshift));
		height: var(--meta);
		line-height: var(--meta);
		margin: 0;
		display: flex;
		justify-content: flex-end;
		gap: 0.75rem;
		font-family: "Abril Fatface", serif;
		font-size: 1.6rem;
		text-align: right;
	}
	/* Right-hand column: up arrow, a small vertical stack of bars showing the
	   position (like the gallery itself), down arrow. */
	.gallery-nav {
		position: absolute;
		right: var(--gap);
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}
	.gallery-nav .gallery-btn {
		position: static;
	}
	.gallery-dots {
		width: var(--nav);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.gallery-dot {
		width: 100%;
		height: 0.6rem;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		position: relative;
	}
	.gallery-dot::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 3px;
		transform: translateY(-50%);
		background: #282827;
		opacity: 0.25;
		transition:
			opacity 0.2s ease,
			height 0.2s ease;
	}
	.gallery-dot:hover::after {
		opacity: 0.6;
	}
	.gallery-dot[aria-current="true"]::after {
		opacity: 1;
		height: 6px;
	}
	.gallery-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: var(--nav);
		height: var(--nav);
		padding: 0;
		border: 0;
		border-radius: 0;
		color: inherit;
		background: rgb(255 255 255 / 0.55);
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.gallery-btn:hover,
	.gallery-btn.is-hot {
		color: #eaeae3;
		background: #3b2ee6;
	}
	.gallery-btn:focus-visible,
	.gallery-dot:focus-visible {
		outline: 2px solid #3b2ee6;
		outline-offset: 2px;
	}
	.gallery-btn svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.gallery-close {
		top: var(--gap);
		right: var(--gap);
	}
	/* Narrow screens: swipe does the work, so there are no arrows and no nav
	   column. The photo takes the full width and the bars sit in the right
	   gutter, against the screen edge, as a position indicator only. */
	@media (max-width: 767px) {
		.gallery-viewer {
			--right: calc(var(--gap) + var(--shift));
		}
		.gallery-prev,
		.gallery-next {
			display: none;
		}
		/* Fit longer titles across the photo. */
		.gallery-meta {
			font-size: 1.25rem;
		}
		.gallery-viewer,
		.gallery-stage {
			touch-action: pinch-zoom;
		}
		/* Level with the photo (see .gallery-stage), in the gutter to its right,
		   touching the screen edge. */
		.gallery-nav {
			top: calc(var(--gap) + var(--vshift));
			bottom: calc(var(--bottom) + var(--shadow));
			right: 0;
			transform: none;
			justify-content: center;
			pointer-events: none;
		}
		.gallery-dots {
			width: calc(var(--gap) - 4px);
			gap: 0;
		}
		.gallery-dot {
			height: 0.5rem;
		}
	}
	.gallery-viewer.is-fading .gallery-btn,
	.gallery-viewer.is-fading .gallery-meta,
	.gallery-viewer.is-fading .gallery-dots {
		opacity: 0;
	}
	.gallery-btn,
	.gallery-meta,
	.gallery-dots {
		transition: opacity 0.25s ease;
	}
	.gallery-viewer.is-zoomed,
	.gallery-viewer.is-zoomed .gallery-stage {
		touch-action: none;
		cursor: grab;
	}
	.gallery-viewer.is-zoomed .gallery-meta,
	.gallery-viewer.is-zoomed .gallery-nav {
		opacity: 0;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.gallery-bar,
		.gallery-viewer::backdrop {
			transition: none;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const EASE = "cubic-bezier(0.2, 0.7, 0.2, 1)";

	type Photo = {
		bar: HTMLButtonElement;
		thumb: HTMLImageElement;
		src: string;
		srcset: string;
		full: string;
		width: number;
		height: number;
		alt: string;
		id: string;
	};

	function setup(root: HTMLElement) {
		const bars = Array.from(root.querySelectorAll<HTMLButtonElement>(".gallery-bar"));
		const photos: Photo[] = bars.map((bar) => {
			const thumb = bar.querySelector("img")!;
			return {
				bar,
				thumb,
				src: bar.dataset.largeSrc!,
				srcset: bar.dataset.largeSrcset!,
				full: bar.dataset.fullSrc!,
				width: Number(bar.dataset.width),
				height: Number(bar.dataset.height),
				alt: thumb.alt,
				id: bar.dataset.id!,
			};
		});

		const viewer = root.querySelector<HTMLDialogElement>(".gallery-viewer")!;
		const stage = viewer.querySelector<HTMLElement>(".gallery-stage")!;
		const img = viewer.querySelector<HTMLImageElement>(".gallery-photo")!;
		const caption = viewer.querySelector<HTMLElement>(".gallery-meta-caption")!;
		const dots = Array.from(viewer.querySelectorAll<HTMLButtonElement>(".gallery-dot"));

		let current = 0;
		let busy = false;
		// Only hand focus back to the stripe when the viewer was opened with the
		// keyboard; after a mouse or touch click, a focus ring would just be noise.
		let openedWithKeyboard = false;
		const loaded = new Set<number>();

		const wrap = (i: number) => (i + photos.length) % photos.length;

		// Large images are sized to the stage: the screen minus the gaps and nav
		// column across, and minus the gaps, caption and shadow down (see CSS).
		// Below 768px there is no nav column (see CSS), so the photo is wider.
		const narrow = window.matchMedia("(max-width: 767px)");
		const sizesFor = (p: Photo) =>
			`min(calc(100vw - ${narrow.matches ? 2 : 5.1}rem), calc((100vh - 5rem - 16px) * ${(p.width / p.height).toFixed(4)}))`;

		function preload(i: number) {
			const p = photos[wrap(i)];
			if (loaded.has(wrap(i))) return;
			const pre = new Image();
			pre.sizes = sizesFor(p);
			pre.srcset = p.srcset;
			pre.src = p.src;
			pre.decode().then(
				() => loaded.add(wrap(i)),
				() => {}
			);
		}

		// Show photo i: put the (already loaded) bar image up first so there is
		// never a blank frame, then swap in the large one once it has decoded.
		// Keep the URL hash on the open photo, so the address can be shared.
		// replaceState: moving between photos shouldn't fill up the history.
		const setHash = (id: string | null) => {
			const url = new URL(location.href);
			url.hash = id ?? "";
			history.replaceState(history.state, "", id ? url : url.href.replace(/#$/, ""));
		};

		// Centre the photo, title and nav as a group: measure the photo in the
		// full stage, then shift everything by half the room it leaves free.
		function fit() {
			zoomOut(false);
			if (!viewer.open) return;
			viewer.style.setProperty("--shift", "0px");
			viewer.style.setProperty("--vshift", "0px");
			// Size the photo from its real shape, not from whichever file is
			// showing (the small stripe image goes up first).
			const p = photos[current];
			const sw = stage.clientWidth;
			const sh = stage.clientHeight;
			const w = Math.min(sw, sh * (p.width / p.height));
			const h = w * (p.height / p.width);
			img.style.width = `${w}px`;
			img.style.height = `${h}px`;
			viewer.style.setProperty("--shift", `${(sw - w) / 2}px`);
			viewer.style.setProperty("--vshift", `${(sh - h) / 2}px`);
		}

		function show(i: number) {
			current = wrap(i);
			const p = photos[current];
			if (viewer.open || opening) setHash(p.id);
			img.width = p.width;
			img.height = p.height;
			img.alt = p.alt;
			img.removeAttribute("srcset");
			img.removeAttribute("sizes");
			img.src = p.thumb.currentSrc || p.thumb.src;

			const large = new Image();
			large.sizes = sizesFor(p);
			large.srcset = p.srcset;
			large.src = p.src;
			const target = current;
			large.decode().then(
				() => {
					loaded.add(target);
					if (current !== target) return;
					img.sizes = large.sizes;
					img.srcset = p.srcset;
					img.src = p.src;
				},
				() => {}
			);

			caption.textContent = p.alt;
			dots.forEach((d, j) =>
				j === current ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")
			);
			fit();
			preload(current + 1);
			preload(current - 1);
		}

		// Animate between a bar on the page and the photo in the viewer.
		// The bar shows a horizontal band of the photo, so we scale the photo
		// down to the bar's width and clip it to the band.
		function barToPhotoKeyframes(p: Photo): Keyframe[] | null {
			const b = p.bar.getBoundingClientRect();
			const f = img.getBoundingClientRect();
			if (!f.width || b.bottom < 0 || b.top > window.innerHeight) return null;
			const k = b.width / f.width;
			const visible = Math.min(f.height, b.height / k);
			const inset = (f.height - visible) / 2;
			const dx = b.left - f.left;
			const dy = b.top + b.height / 2 - (f.top + (f.height * k) / 2);
			return [
				{
					transformOrigin: "top left",
					transform: `translate(${dx}px, ${dy}px) scale(${k})`,
					clipPath: `inset(${inset}px 0px ${inset}px 0px)`,
				},
				{
					transformOrigin: "top left",
					transform: "none",
					// Negative inset so the drop shadow isn't cut off.
					clipPath: "inset(-120px -120px -120px -120px)",
				},
			];
		}

		let opening = false;
		function open(i: number) {
			opening = true;
			show(i);
			opening = false;
			viewer.classList.add("is-fading");
			viewer.showModal();
			// showModal() focuses the first button (close), which then shows a
			// focus ring as soon as an arrow key is pressed. Focus the dialog
			// itself instead; Tab still reaches the buttons.
			viewer.focus({ preventScroll: true });
			fit();
			document.documentElement.style.overflow = "hidden";
			requestAnimationFrame(() => {
				viewer.classList.remove("is-fading");
				if (reduceMotion.matches) return;
				const frames = barToPhotoKeyframes(photos[current]);
				if (frames) {
					img.animate(frames, { duration: 420, easing: EASE });
				} else {
					img.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 250 });
				}
			});
		}

		async function close() {
			if (busy || !viewer.open) return;
			zoomOut(false);
			busy = true;
			const p = photos[current];
			// Keep the page in step, so closing lands on the photo you were on.
			const b = p.bar.getBoundingClientRect();
			if (b.top < 0 || b.bottom > window.innerHeight) {
				p.bar.scrollIntoView({ block: "center" });
			}
			if (!reduceMotion.matches) {
				viewer.classList.add("is-fading");
				const frames = barToPhotoKeyframes(p);
				const anim = frames
					? img.animate(frames.slice().reverse(), {
							duration: 360,
							easing: EASE,
							fill: "forwards",
						})
					: img.animate([{ opacity: 1 }, { opacity: 0 }], {
							duration: 200,
							fill: "forwards",
						});
				await anim.finished.catch(() => {});
				anim.cancel();
			}
			viewer.close();
			viewer.classList.remove("is-fading");
			busy = false;
		}

		viewer.addEventListener("close", () => {
			document.documentElement.style.overflow = "";
			setHash(null);
			if (openedWithKeyboard) {
				photos[current].bar.focus({ preventScroll: true });
			} else {
				// The dialog returns focus to the stripe that opened it; drop it.
				(document.activeElement as HTMLElement | null)?.blur();
			}
		});

		async function go(step: number) {
			if (busy || !step) return;
			zoomOut(false);
			if (reduceMotion.matches) return show(current + step);
			busy = true;
			const out = img.animate(
				[
					{ transform: "translateY(0)", opacity: 1 },
					{ transform: `translateY(${-step * 60}px)`, opacity: 0 },
				],
				{ duration: 160, easing: "ease-in", fill: "forwards" }
			);
			await out.finished.catch(() => {});
			show(current + step);
			out.cancel();
			await img
				.animate(
					[
						{ transform: `translateY(${step * 60}px)`, opacity: 0 },
						{ transform: "translateY(0)", opacity: 1 },
					],
					{ duration: 220, easing: EASE }
				)
				.finished.catch(() => {});
			busy = false;
		}

		bars.forEach((bar, i) =>
			bar.addEventListener("click", (e) => {
				// detail is 0 when the button was activated with Enter or Space.
				openedWithKeyboard = e.detail === 0;
				open(i);
			})
		);
		dots.forEach((dot, i) =>
			dot.addEventListener("click", () => {
				if (i !== current) go(i - current);
			})
		);
		// On narrow screens the bars only show the position: keep them out of
		// the tab order there.
		const syncDots = () => dots.forEach((d) => (d.tabIndex = narrow.matches ? -1 : 0));
		syncDots();
		narrow.addEventListener("change", syncDots);
		viewer.querySelector(".gallery-close")!.addEventListener("click", () => close());
		viewer.querySelector(".gallery-prev")!.addEventListener("click", () => go(-1));
		viewer.querySelector(".gallery-next")!.addEventListener("click", () => go(1));

		viewer.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown" || e.key === "ArrowRight") go(1);
			else if (e.key === "ArrowUp" || e.key === "ArrowLeft") go(-1);
			else if (e.key === "Home") go(-current);
			else if (e.key === "End") go(photos.length - 1 - current);
			else if (e.key === "Escape") {
				e.preventDefault();
				if (zoomed) zoomOut();
				else close();
			} else return;
			e.preventDefault();
		});
		window.addEventListener("resize", fit);

		// Esc can also arrive as a "cancel" event without a keydown (e.g. back gesture).
		viewer.addEventListener("cancel", (e) => {
			e.preventDefault();
			if (zoomed) zoomOut();
			else close();
		});

		// The whole top/bottom half of the stage acts as the up/down button,
		// so light up that button while the pointer is over its half.
		const prevBtn = viewer.querySelector<HTMLElement>(".gallery-prev")!;
		const nextBtn = viewer.querySelector<HTMLElement>(".gallery-next")!;
		const sideOf = (y: number) => (y < window.innerHeight / 2 ? -1 : 1);
		stage.addEventListener("pointermove", (e) => {
			if (e.pointerType !== "mouse") return;
			const side = zoomed ? 0 : sideOf(e.clientY);
			prevBtn.classList.toggle("is-hot", side < 0);
			nextBtn.classList.toggle("is-hot", side > 0);
		});
		stage.addEventListener("pointerleave", () => {
			prevBtn.classList.remove("is-hot");
			nextBtn.classList.remove("is-hot");
		});

		// Zoom: show the photo at 100% (one photo pixel per screen pixel), centred
		// on the point that was double-clicked, and drag to pan. The photo's
		// transform origin is its top-left corner (see CSS).
		let zoomed = false;
		let zs = 1;
		let zx = 0;
		let zy = 0;
		let base = new DOMRect();

		function applyZoom(animate: boolean) {
			img.style.transition = animate && !reduceMotion.matches ? "transform 0.3s ease" : "";
			img.style.transform = zoomed ? `translate(${zx}px, ${zy}px) scale(${zs})` : "";
		}
		// Keep the photo covering the screen while it is bigger than it, and
		// centred along any side where it is smaller.
		function clampPan() {
			const vw = window.innerWidth;
			const vh = window.innerHeight;
			const w = base.width * zs;
			const h = base.height * zs;
			zx =
				w > vw ? Math.min(-base.left, Math.max(vw - base.left - w, zx)) : (vw - w) / 2 - base.left;
			zy = h > vh ? Math.min(-base.top, Math.max(vh - base.top - h, zy)) : (vh - h) / 2 - base.top;
		}
		function zoomIn(cx: number, cy: number) {
			const p = photos[current];
			img.style.transform = "";
			base = img.getBoundingClientRect();
			zs = p.width / (base.width * (window.devicePixelRatio || 1));
			if (zs <= 1.05) return; // Already shown at (about) full size.
			zoomed = true;
			zx = (cx - base.left) * (1 - zs);
			zy = (cy - base.top) * (1 - zs);
			clampPan();
			viewer.classList.add("is-zoomed");
			applyZoom(true);
			// Swap in the full-size file once it has decoded.
			const full = new Image();
			full.src = p.full;
			const target = current;
			full.decode().then(
				() => {
					if (zoomed && current === target) {
						img.removeAttribute("srcset");
						img.removeAttribute("sizes");
						img.src = p.full;
					}
				},
				() => {}
			);
		}
		function zoomOut(animate = true) {
			if (!zoomed) return;
			zoomed = false;
			viewer.classList.remove("is-zoomed");
			applyZoom(animate);
		}
		viewer.addEventListener("dblclick", (e) => e.preventDefault());

		// Taps wait a moment, so the first tap of a double tap doesn't also
		// move to another photo.
		let tapTimer = 0;
		let lastTap = { t: 0, x: 0, y: 0 };
		function tap(e: PointerEvent) {
			const now = performance.now();
			const near = Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) < 40;
			if (tapTimer && now - lastTap.t < 300 && near) {
				clearTimeout(tapTimer);
				tapTimer = 0;
				if (zoomed) zoomOut();
				else zoomIn(e.clientX, e.clientY);
				return;
			}
			lastTap = { t: now, x: e.clientX, y: e.clientY };
			const side = sideOf(e.clientY);
			clearTimeout(tapTimer);
			tapTimer = window.setTimeout(() => {
				tapTimer = 0;
				if (!zoomed) go(side);
			}, 300);
		}

		// Swipe: the photo follows your finger; let go past a threshold to move on.
		// Left or up goes to the next photo, right or down to the previous one.
		// Vertical swipes only on narrow screens, where nothing else uses them.
		let startX = 0;
		let startY = 0;
		let dx = 0;
		let axis: "x" | "y" = "x";
		let tracking = false;
		let moved = false;
		let panX = 0;
		let panY = 0;

		// On narrow screens swipes work anywhere in the viewer, not just on the
		// photo; taps still only count on the photo.
		let onStage = false;
		viewer.addEventListener("pointerdown", (e) => {
			if (busy || (e.pointerType === "mouse" && e.button !== 0)) return;
			const target = e.target as Element;
			if (target.closest("button")) return;
			onStage = stage.contains(target);
			if (!onStage && !narrow.matches && !zoomed) return;
			tracking = true;
			moved = false;
			startX = e.clientX;
			startY = e.clientY;
			dx = 0;
			panX = zx;
			panY = zy;
			img.style.transition = "";
		});
		viewer.addEventListener("pointermove", (e) => {
			if (!tracking) return;
			const mx = e.clientX - startX;
			const my = e.clientY - startY;
			if (zoomed) {
				// While zoomed in, dragging pans instead of swiping.
				if (!moved && Math.hypot(mx, my) < 4) return;
				if (!moved) viewer.setPointerCapture(e.pointerId);
				moved = true;
				zx = panX + mx;
				zy = panY + my;
				clampPan();
				applyZoom(false);
				return;
			}
			if (!moved) {
				if (Math.abs(mx) > 8 && Math.abs(mx) > Math.abs(my)) axis = "x";
				else if (narrow.matches && Math.abs(my) > 8 && Math.abs(my) > Math.abs(mx)) axis = "y";
				else return;
				moved = true;
				viewer.setPointerCapture(e.pointerId);
			}
			dx = axis === "x" ? mx : my;
			img.style.transform = `translate${axis.toUpperCase()}(${dx}px)`;
			img.style.opacity = String(1 - Math.min(Math.abs(dx) / 600, 0.5));
		});
		const endSwipe = async (e: PointerEvent) => {
			if (!tracking) return;
			tracking = false;
			if (!moved) {
				// A plain click/tap: the top half goes back, the bottom half forward;
				// a double one zooms.
				if (e.type === "pointerup" && onStage) tap(e);
				return;
			}
			if (zoomed) return;
			const threshold = Math.min(90, window.innerWidth * 0.18);
			const step = dx < -threshold ? 1 : dx > threshold ? -1 : 0;
			if (step === 0 || reduceMotion.matches) {
				img.style.transform = "";
				img.style.opacity = "";
				if (step) show(current + step);
				return;
			}
			busy = true;
			const out = img.animate(
				[
					{ transform: img.style.transform, opacity: img.style.opacity },
					{
						transform:
							axis === "x"
								? `translateX(${dx}px) translateY(${-step * 60}px)`
								: `translateY(${dx - step * 60}px)`,
						opacity: 0,
					},
				],
				{ duration: 160, easing: "ease-out", fill: "forwards" }
			);
			img.style.transform = "";
			img.style.opacity = "";
			await out.finished.catch(() => {});
			show(current + step);
			out.cancel();
			await img
				.animate(
					[
						{ transform: `translateY(${step * 60}px)`, opacity: 0 },
						{ transform: "translateY(0)", opacity: 1 },
					],
					{ duration: 220, easing: EASE }
				)
				.finished.catch(() => {});
			busy = false;
		};
		viewer.addEventListener("pointerup", endSwipe);
		viewer.addEventListener("pointercancel", endSwipe);

		// Open the photo named in the URL hash, on load and when the hash changes.
		const openFromHash = () => {
			let id: string;
			try {
				id = decodeURIComponent(location.hash.slice(1));
			} catch {
				return; // A malformed hash (e.g. "#%") names no photo.
			}
			const i = photos.findIndex((p) => p.id === id);
			if (i < 0) return;
			if (viewer.open) {
				if (i !== current) show(i);
				return;
			}
			// Bring its stripe into view first, so closing lands on it.
			photos[i].bar.scrollIntoView({ block: "center" });
			openedWithKeyboard = false;
			open(i);
		};
		openFromHash();
		window.addEventListener("hashchange", openFromHash);
	}

	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => setup(root));
</script>
