---
const { pathname } = Astro.url;

const links = [
	{ href: "/", label: "about", current: pathname === "/" },
	{ href: "/blog/", label: "blog", current: pathname.startsWith("/blog") },
];
---

<nav class="fixed top-0 w-full lg:w-min lg:right-0 p-6 bg-white/60 backdrop-blur-sm text-xl">
	<ul class="flex justify-end gap-6">
		{links.map(({ href, label, current }) => (
			<li>
				<a
					class={current ? "text-zinc-600" : "underline text-ink"}
					href={href}
					aria-current={current ? "page" : undefined}
				>
					{label}
				</a>
			</li>
		))}
	</ul>
</nav>
