---
import Base from "../layouts/base.astro";
---

<Base title="Page not found" description="This page does not exist.">
	<article class="container mx-auto max-w-3xl bg-white p-16 my-8 shadow-[0_16px_0px_rgba(0,0,0,0.4)]">
		<h1 class="font-display text-4xl mb-8">Page not found</h1>
		<p class="text-lg">
			There is nothing at this address. Try the
			<a class="underline text-ink" href="/blog/">blog</a> or the
			<a class="underline text-ink" href="/">about page</a>.
		</p>
	</article>
</Base>
