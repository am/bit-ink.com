---
import FormattedDate from "@components/FormattedDate.astro";
import { Image, getImage } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Base from "../../layouts/base.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { posts, post },
	}));
}
type Props = {
	post: CollectionEntry<"blog">;
	posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const { description, heroImage, pubDate, title, updatedDate } = post.data;
const { Content } = await render(post);

// Link previews get a 1200 px JPEG of the hero, which every social site can read.
const socialImage = heroImage
	? (await getImage({ src: heroImage, width: 1200, format: "jpeg" })).src
	: undefined;

// Oldest first. Copy before sorting: `posts` is shared by every page.
const sortedPosts = [...posts].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);

// The newer post is linked above this one and the older post below it.
const olderPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const newerPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
---

<Base
	title={title}
	description={description}
	image={socialImage}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
>
	{newerPost && (
		<article class="container mx-auto max-w-3xl p-4 bg-white shadow-[0_16px_0px_rgba(0,0,0,0.4)]">
			<div class="flex justify-between items-center">
				<a class="text-lg underline text-ink" href={`/blog/${newerPost.id}/`}>
					{newerPost.data.title}
				</a>
				<div class="text-sm uppercase">
					<FormattedDate date={newerPost.data.pubDate} />
				</div>
			</div>
		</article>
	)}
	<article class="container mx-auto max-w-3xl bg-white my-8 shadow-[0_16px_0px_rgba(0,0,0,0.4)]">
		<section class="relative p-4 pb-0">
			{heroImage && (
				<Image
					src={heroImage}
					width={736}
					densities={[1, 2]}
					alt=""
					loading="eager"
					fetchpriority="high"
				/>
			)}
			<div class="absolute top-0 right-0 pt-4 pb-2 px-4 uppercase bg-white text-sm text-right">
				<div class="font-bold">
					<FormattedDate date={pubDate} />
				</div>
				{updatedDate && (
					<div class="text-zinc-600">
						+ <FormattedDate date={updatedDate} />
					</div>
				)}
			</div>
		</section>
		<section class="prose prose-lg max-w-none prose-headings:font-display p-16">
			<h1 class="">{title}</h1>
			<Content />
		</section>
	</article>

	{olderPost && (
		<article class="container mx-auto max-w-3xl p-4 bg-white shadow-[0_16px_0px_rgba(0,0,0,0.4)]">
			<div class="flex justify-between items-center">
				<a class="text-lg underline text-ink" href={`/blog/${olderPost.id}/`}>
					{olderPost.data.title}
				</a>
				<div class="text-sm uppercase">
					<FormattedDate date={olderPost.data.pubDate} />
				</div>
			</div>
		</article>
	)}
</Base>
