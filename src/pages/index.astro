---
import Base from "../layouts/base.astro";
import { SITE_TITLE, SITE_AUTHOR, SITE_TOPIC } from "../consts";
import { Content as About } from "../content/pages/index.mdx";
---

<Base bodyClass="flex flex-col bg-white text-black font-sans">
	<header
		slot="header"
		class="flex h-[80vh] px-4 justify-center items-center bg-cover bg-hero-background"
	>
		<div class="flex flex-col mt-10">
			<div class="text-center bg-white p-10 lg:p-16 pb-4 lg:pb-6">
				<h1 class="font-display font-bold text-6xl lg:text-8xl mb-4 lg:mb-8">{SITE_TITLE}</h1>
				<h2 class="text-xl lg:text-2xl font-bold">{SITE_AUTHOR}</h2>
			</div>
			<div class="text-center bg-black px-8 py-4">
				<h2 class="text-xl lg:text-2xl text-white">{SITE_TOPIC}</h2>
			</div>
		</div>
	</header>

	<div class="container mx-auto max-w-3xl pt-16 pb-32">
		<section class="p-8 prose prose-xl prose-a:text-ink prose-headings:font-display">
			<About />
		</section>
	</div>
</Base>
